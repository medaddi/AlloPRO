# Copy to .env and fill with your Supabase project values (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: ALLO LM3LM support WhatsApp (international digits, e.g. 2126XXXXXXXX) for subscription renewals
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# Google Maps SDK for Android key (Google Cloud console). Also add it as an EAS secret.
GOOGLE_MAPS_API_KEY=
